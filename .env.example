SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Path where the Django admin is mounted (not /admin/, to keep it off of bots
# scanning for the default path). Day-to-day work happens in the management
# panel: "Settings" in the navbar once you are signed in.
ADMIN_URL=system-console/

# Google Search Console ownership token (the content of its <meta> tag).
# Leave blank locally; set on the host once the site is verified there.
GOOGLE_SITE_VERIFICATION=

# Cloudflare R2 (or any S3-compatible bucket) for uploaded product/about
# images. Leave unset locally — media then falls back to local disk. Must
# be set in production, since a host's local disk doesn't survive redeploys.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# Production: one connection string from the managed database (it takes
# precedence over the DB_* values below, and requires SSL). Leave unset locally.
DATABASE_URL=

# Local development: a plain PostgreSQL (see docker-compose.yml).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mobile_shop_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Comma-separated origins allowed to submit forms, with scheme. Leave blank
# to derive https://<host> from ALLOWED_HOSTS, which is right for almost
# every deployment.
CSRF_TRUSTED_ORIGINS=

# Root log level for the console handler (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# First deploy only: build.sh creates this staff account once, if the username
# is set. Remove these three afterwards (or leave the username blank).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
